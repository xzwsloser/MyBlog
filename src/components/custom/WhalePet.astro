<div class='whale-pet' aria-live='polite'>
  <button
    class='whale-button'
    type='button'
    aria-expanded='false'
    aria-controls='whale-speech'
    aria-label='Chat with the whale mascot'
  >
    <svg viewBox='0 0 96 96' role='presentation' aria-hidden='true'>
      <defs>
        <linearGradient id='whale-body' x1='0' y1='0' x2='1' y2='1'>
          <stop offset='0%' stop-color='#7ff0ff'></stop>
          <stop offset='58%' stop-color='#4aa8ff'></stop>
          <stop offset='100%' stop-color='#5d6bff'></stop>
        </linearGradient>
      </defs>
      <path
        d='M68 62c9-5 15-1 18 6-4 3-8 4-12 4-3 0-6-2-8-5z'
        fill='#37d0ff'
      ></path>
      <path
        d='M16 50c0-19 14-33 32-33 13 0 23 7 28 17 3 6 1 11-4 14l-10 6c-6 4-12 6-19 6-15 0-27-4-27-10z'
        fill='url(#whale-body)'
      ></path>
      <path d='M25 36c7-10 18-14 28-10-4 6-10 10-17 11-5 1-9 0-11-1z' fill='#312e81' opacity='.92'></path>
      <ellipse cx='46' cy='49' rx='19' ry='17' fill='#ffe8dc'></ellipse>
      <path d='M27 40c3-8 11-12 18-11-5 4-9 6-12 11-2 4-4 4-6 0z' fill='#312e81'></path>
      <path d='M51 28c8 1 14 6 17 13-6-2-11-5-17-7z' fill='#312e81'></path>
      <path d='M34 49c2-2 5-2 7 0' stroke='#172554' stroke-width='2.6' stroke-linecap='round' fill='none'></path>
      <path d='M50 49c2-2 5-2 7 0' stroke='#172554' stroke-width='2.6' stroke-linecap='round' fill='none'></path>
      <circle cx='37.5' cy='50.5' r='1.5' fill='#172554'></circle>
      <circle cx='53.5' cy='50.5' r='1.5' fill='#172554'></circle>
      <ellipse cx='31.5' cy='55' rx='4' ry='2' fill='#ff9bbd' opacity='.55'></ellipse>
      <ellipse cx='60.5' cy='55' rx='4' ry='2' fill='#ff9bbd' opacity='.55'></ellipse>
      <path d='M43 56c2 2 5 2 7 0' stroke='#b83b6b' stroke-width='1.8' stroke-linecap='round' fill='none'></path>
      <path d='M22 66c8 4 18 6 28 3' stroke='rgba(255,255,255,.38)' stroke-width='4' stroke-linecap='round' fill='none'></path>
      <path d='M15 48c-3 4-3 8-1 11 3-3 4-7 1-11z' fill='#50d8ff'></path>
    </svg>
  </button>
  <div class='whale-speech' id='whale-speech' hidden>
    <span class='speech-text'>Hello!</span>
  </div>
</div>

<style>
  .whale-pet {
    position: fixed;
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 80;
    pointer-events: none;
  }

  .whale-button {
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    background: hsl(var(--card) / 0.12);
    box-shadow: 0 18px 38px -18px hsl(190 95% 55% / 0.7);
    transition: transform 0.25s ease, filter 0.25s ease;
    animation: whale-swim 5s ease-in-out infinite;
  }

  .whale-button:hover {
    transform: translateY(-5px) rotate(-5deg);
    filter: drop-shadow(0 0 16px hsl(190 95% 55% / 0.65));
  }

  .whale-button.is-active {
    animation: whale-happy 0.55s ease;
  }

  .whale-button svg {
    width: 3.4rem;
    height: 3.4rem;
    transition: transform 0.25s ease;
  }

  .whale-button.is-active svg {
    transform: rotate(-8deg) scale(1.05);
  }

  .whale-speech {
    pointer-events: none;
    position: absolute;
    right: 4.9rem;
    bottom: 1.15rem;
    width: max-content;
    max-width: min(17rem, calc(100vw - 9.5rem));
    padding: 0.7rem 0.9rem;
    border: 1px solid hsl(var(--primary) / 0.18);
    border-radius: 1.1rem 1.1rem 0.25rem 1.1rem;
    background: hsl(var(--card) / 0.82);
    color: hsl(var(--foreground) / 0.92);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: center;
    box-shadow: 0 18px 38px -20px hsl(var(--primary) / 0.6);
    backdrop-filter: blur(16px);
    animation: speech-pop 0.28s ease;
  }

  @keyframes whale-swim {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
    }
    50% {
      transform: translateY(-7px) rotate(-4deg);
    }
  }

  @keyframes speech-pop {
    0% {
      opacity: 0;
      transform: translateX(10px) scale(0.96);
    }
    100% {
      opacity: 1;
      transform: translateX(0) scale(1);
    }
  }

  @keyframes whale-happy {
    0%,
    100% {
      transform: translateY(0) rotate(0deg) scale(1);
    }
    40% {
      transform: translateY(-12px) rotate(-5deg) scale(1.05);
    }
    70% {
      transform: translateY(-3px) rotate(2deg) scale(1.02);
    }
  }

  @media (max-width: 640px) {
    .whale-button {
      width: 3.7rem;
      height: 3.7rem;
    }
    .whale-button svg {
      width: 2.7rem;
      height: 2.7rem;
    }
    .whale-speech {
      right: 4.1rem;
      bottom: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .whale-button,
    .whale-speech {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  const speech = document.querySelector<HTMLElement>('.whale-speech')
  const text = speech?.querySelector<HTMLElement>('.speech-text')
  const button = document.querySelector<HTMLButtonElement>('.whale-button')
  const messages = {
    en: ['Keep exploring!', 'Every step counts.', 'Hello, traveler.', 'Let’s learn something today.'],
    zh: ['继续探索吧！', '每一步都算数。', '你好，旅行者。', '今天也一起学习吧。']
  }

  function hideSpeech() {
    if (!speech || !button) return
    speech.hidden = true
    button.setAttribute('aria-expanded', 'false')
    button.classList.remove('is-active')
  }

  button?.addEventListener('click', () => {
    if (!speech || !text || !button) return
    if (!speech.hidden) {
      hideSpeech()
      return
    }
    const lang = document.documentElement.getAttribute('data-lang') === 'zh' ? 'zh' : 'en'
    const pool = messages[lang]
    text.textContent = pool[Math.floor(Math.random() * pool.length)] ?? 'Hello!'
    speech.hidden = false
    button.setAttribute('aria-expanded', 'true')
    button.classList.add('is-active')
  })

  document.addEventListener('click', (event) => {
    if (!button || button.contains(event.target as Node)) return
    hideSpeech()
  })
</script>

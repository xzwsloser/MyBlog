---
import config from 'virtual:config'

import { Icon } from 'astro-pure/user'

const footerConf = config.footer
const social = footerConf.social || []

const footerLink1 = footerConf.links?.filter(({ pos }) => pos === 1) || []
---

<footer class='mx-auto mb-8 mt-20 w-full'>
  <div class='border-t border-border/50 pt-6'>
    <div class='flex items-center gap-y-3 max-sm:flex-col sm:justify-between sm:gap-y-0'>
      <div class='flex items-center gap-x-3 gap-y-2 text-xs text-muted-foreground max-sm:flex-col'>
        {
          footerLink1.length > 0 && (
            <div>
              {footerLink1.map(({ title, link, style }, index) => (
                <>
                  <a href={link} target='_blank' class={style}>
                    {title}
                  </a>
                  {index < footerLink1.length - 1 && <span class='mx-1 opacity-40'>·</span>}
                </>
              ))}
            </div>
          )
        }
        <div>
          <span class='opacity-60'>{config.footer.year} {config.author}</span>
          {
            footerConf.links && footerConf.links.filter(({ pos }) => pos === 2).length > 0 && (
              <>
                <span class='mx-1 opacity-40'>·</span>
                {footerConf.links
                  .filter(({ pos }) => pos === 2)
                  .map(({ title, link, style }) => (
                    <a href={link} target='_blank' class={style}>
                      {title}
                    </a>
                  ))}
              </>
            )
          }
        </div>
        {
          footerConf.credits && (
            <span class='opacity-50'>
              <a href='https://github.com/withastro/astro' target='_blank'>Astro</a>
              <span class='mx-0.5 opacity-40'>+</span>
              <a href='https://github.com/cworld1/astro-theme-pure' target='_blank'>Pure</a>
            </span>
          )
        }
      </div>

      <div class='flex items-center gap-x-4'>
        {
          social.map(({ label, href, icon }) => (
            <a {href} rel='me' class='sl-flex text-muted-foreground/60 transition-colors hover:text-muted-foreground'>
              <span class='sr-only'>{label}</span>
              <Icon name={icon} />
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  footer a {
    color: hsl(var(--foreground) / var(--un-text-opacity, 1));
    text-decoration: none;
    font-weight: 450;
    transition: color 0.2s ease;
  }
  footer a:hover {
    color: hsl(var(--primary) / var(--un-text-opacity, 1));
  }
</style>

---
import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import Section from '@/components/home/Section.astro'
import config from '@/site-config'

const MAX_POSTS = 10
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)

---

<PageLayout meta={{ title: 'Home' }} highlightColor='#7C5CFF'>
  <main class='flex w-full flex-col items-center'>
    <section class='animate mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='text-4xl font-semibold tracking-tight sm:text-5xl'>
          <span
            class='bg-clip-text text-transparent'
            style='background-image:linear-gradient(120deg,hsl(var(--primary)),hsl(var(--accent)))'
          >
            {config.author}
          </span>
        </h1>
        <p class='max-w-md text-center text-sm leading-relaxed text-muted-foreground'>
          <span class='lang-en'>Exploring AI Infra, LLMs, and Backend Systems</span>
          <span class='lang-zh hidden'>探索 AI Infra、大模型与后端系统</span>
        </p>
        <div class='flex flex-wrap items-center justify-center gap-x-5 gap-y-3'>
          <Label title='GitHub' as='a' href='https://github.com/xzwsloser' target='_blank'>
            <Icon name='github' class='size-5' slot='icon' />
          </Label>
          <!-- Language toggle -->
          <button
            id='lang-toggle'
            data-lang-toggle
            class='inline-flex items-center gap-1 rounded-full border bg-background px-3 py-1 text-xs font-medium text-muted-foreground shadow-sm transition hover:border-primary/50 hover:text-foreground'
            aria-label='Toggle language'
          >
            <span class='lang-label' data-lang='en'>EN</span>
            <span class='lang-label hidden' data-lang='zh'>中文</span>
            <span class='text-[10px]'>/</span>
          </button>
        </div>
      </div>

      <a
        href='https://github.com/xzwsloser'
        target='_blank'
        class='flex flex-row items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
      >
        <span class='relative flex items-center justify-center'>
          <span class='absolute size-2 animate-ping rounded-full border border-green-400 bg-green-400 opacity-75' />
          <span class='size-2 rounded-full bg-green-400' />
        </span>
        <p class='font-medium text-muted-foreground'>
          <span class='lang-en'>Open to collaborate</span>
          <span class='lang-zh hidden'>欢迎交流与合作</span>
        </p>
      </a>
    </section>

    <div id='content' class='flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <!-- About Me -->
      <Section title='About Me' class='animate' style='animation-delay:150ms'>
        <p class='text-muted-foreground lang-en'>
          Student and developer, currently diving into AI Infrastructure, LLMs / Multi-modal,
          Agent architectures, and backend system design. Passionate about low-level computer
          systems and the engineering behind large-scale AI — always learning, always building.
        </p>
        <p class='text-muted-foreground lang-zh hidden'>
          学生 / 开发者，正在学习 AI Infra、大模型 / 多模态、Agent、后端架构设计等技术，
          对计算机底层技术感兴趣，持续学习与探索中。
        </p>
        <Button title='More about me' class='w-fit self-end' href='/about' variant='ahead' />
      </Section>

      <!-- Recent Posts -->
      {
        allPostsByDate.length > 0 && (
          <Section title='Recent Posts' class='animate' style='animation-delay:175ms'>
            <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
              {allPostsByDate.map((p) => (
                <li class='flex flex-col gap-x-2 sm:flex-row'>
                  <PostPreview post={p} />
                </li>
              ))}
            </ul>
            <Button title='View all posts' class='w-fit self-end' href='/blog' variant='ahead' />
          </Section>
        )
      }

    </div>

    <Quote class='mt-12' />
  </main>
</PageLayout>

<style>
  #lang-toggle:hover {
    border-color: hsl(var(--primary) / 0.5);
  }
</style>

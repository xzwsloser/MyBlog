---
import PageLayout from '@/layouts/BaseLayout.astro'
import { profile } from '../../data/profile'
---

<PageLayout meta={{ title: 'About', description: profile.intro.en }}>
  <main class='profile-shell' id='content'>
    <section class='profile-card'>
      <div class='profile-meta'>
        <p class='profile-eyebrow'>
          <span class='lang-en'>About</span>
          <span class='lang-zh hidden'>关于</span>
        </p>
        <button class='profile-lang' type='button' data-lang-toggle aria-label='Toggle language'>
          <span class='lang-label' data-lang='en'>EN</span>
          <span class='lang-label hidden' data-lang='zh'>中文</span>
        </button>
      </div>
      <h1 class='profile-name'>
        <span class='lang-en'>{profile.name.en}</span>
        <span class='lang-zh hidden'>{profile.name.zh}</span>
      </h1>
      <p class='profile-school'>
        <span class='lang-en'>{profile.school.en}</span>
        <span class='lang-zh hidden'>{profile.school.zh}</span>
      </p>
      <p class='profile-intro'>
        <span class='lang-en'>{profile.intro.en}</span>
        <span class='lang-zh hidden'>{profile.intro.zh}</span>
      </p>
      <div class='focus-grid' aria-label='Focus areas'>
        {
          profile.focus.map((item) => (
            <article class='focus-card'>
              <h2>{item.label}</h2>
              <p>
                <span class='lang-en'>{item.description.en}</span>
                <span class='lang-zh hidden'>{item.description.zh}</span>
              </p>
            </article>
          ))
        }
      </div>
      <p class='profile-learning'>
        <span class='lang-en'>{profile.learning.en}</span>
        <span class='lang-zh hidden'>{profile.learning.zh}</span>
      </p>
    </section>
  </main>
</PageLayout>

<style>
  .profile-shell {
    display: flex;
    width: 100%;
    justify-content: center;
    padding-block: 2rem 4rem;
  }

  .profile-card {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 56rem;
    padding: clamp(2rem, 6vw, 4.5rem);
    border-radius: 1.5rem;
    border: 1px solid hsl(var(--primary) / 0.16);
    background:
      radial-gradient(circle at top right, hsl(var(--primary) / 0.14), transparent 42%),
      hsl(var(--card) / 0.78);
    box-shadow: 0 24px 70px -35px hsl(var(--primary) / 0.4);
    backdrop-filter: blur(18px);
  }

  .profile-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent, hsl(var(--primary) / 0.1), transparent);
    transform: translateX(-100%);
    animation: profile-sheen 5.5s ease-in-out infinite;
    pointer-events: none;
  }

  .profile-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .profile-eyebrow {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(var(--primary) / 0.9);
  }

  .profile-lang {
    flex: none;
    padding: 0.38rem 0.72rem;
    border: 1px solid hsl(var(--primary) / 0.18);
    border-radius: 999px;
    background: hsl(var(--background) / 0.58);
    color: hsl(var(--muted-foreground) / 1);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease, transform 0.25s ease;
  }

  .profile-lang:hover {
    transform: translateY(-1px);
    border-color: hsl(var(--primary) / 0.48);
    color: hsl(var(--foreground) / 1);
  }

  .profile-name {
    margin: 0;
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    background: linear-gradient(120deg, hsl(var(--primary)), hsl(var(--accent)));
    background-clip: text;
    color: transparent;
  }

  .profile-school {
    margin-top: 0.7rem;
    font-size: clamp(1rem, 2.4vw, 1.35rem);
    font-weight: 500;
    color: hsl(var(--foreground) / 0.82);
  }

  .profile-intro,
  .profile-learning {
    margin: 1.4rem 0 0;
    max-width: 44rem;
    font-size: 1.06rem;
    line-height: 1.85;
    color: hsl(var(--muted-foreground) / 1);
  }

  .profile-learning {
    margin-top: 1.8rem;
    font-style: italic;
  }

  .focus-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin-top: 2.5rem;
  }

  .focus-card {
    min-width: 0;
    padding: 1.1rem 1.2rem;
    border: 1px solid hsl(var(--primary) / 0.16);
    border-radius: 1rem;
    background: hsl(var(--background) / 0.64);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .focus-card:hover {
    transform: translateY(-3px);
    border-color: hsl(var(--primary) / 0.38);
    box-shadow: 0 18px 38px -24px hsl(var(--primary) / 0.6);
  }

  .focus-card h2 {
    margin: 0;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    color: hsl(var(--foreground) / 1);
  }

  .focus-card p {
    margin: 0.3rem 0 0;
    font-size: 0.875rem;
    line-height: 1.55;
    color: hsl(var(--muted-foreground) / 1);
  }

  @keyframes profile-sheen {
    0%,
    100% {
      transform: translateX(-100%);
      opacity: 0;
    }
    35% {
      transform: translateX(100%);
      opacity: 1;
    }
    70% {
      transform: translateX(100%);
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .profile-card {
      padding: 2rem 1.4rem;
      border-radius: 1.25rem;
    }
    .focus-grid {
      grid-template-columns: 1fr;
      gap: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .profile-card::before,
    .focus-card {
      animation: none;
      transition: none;
    }
  }
</style>

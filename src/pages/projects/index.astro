---
import { Image } from 'astro:assets'

import PageLayout from '@/layouts/CommonPage.astro'
import ProjectSection from '@/components/projects/ProjectSection.astro'

const headings = [
  { depth: 2, slug: 'learnings', text: 'Learnings' }
]
---

<PageLayout title='Projects' {headings} view>
  <div class='not-prose flex justify-center'>
    <a
      href='https://github.com/xzwsloser' target='_blank'
      class='flex items-center gap-x-3 rounded-full border bg-background px-4 py-2 text-sm shadow-sm transition-shadow hover:shadow-md'
    >
      <span class='size-2 rounded-full bg-green-400'></span>
      <p class='font-medium text-muted-foreground'>View my GitHub Profile</p>
    </a>
  </div>
  <p>Github Activities:</p>
  <p>
    <Image
      src='https://ghchart.rshah.org/659eb9/xzwsloser'
      alt='github activities'
      inferSize
      loading='lazy'
    />
  </p>

  <h2 id='learnings'>Learnings</h2>
  <ProjectSection
    class='my-2'
    projects={[
      {
        name: 'AI Infra',
        description: 'GPU architecture, CUDA programming, distributed training, and model inference',
        links: [
          { type: 'site', href: '/docs/ai-infra/overview' }
        ]
      },
      {
        name: 'Backend Development',
        description: 'Go concurrency, MySQL optimization, Redis caching, and distributed systems',
        links: [
          { type: 'site', href: '/docs/backend/overview' }
        ]
      }
    ]}
  />
</PageLayout>
